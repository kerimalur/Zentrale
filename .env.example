# ============================================================
# Kerims Zentrale – Einstellungen
# Kopieren:  cp .env.example .env   ·   Schützen:  chmod 600 .env
# Nach jeder Änderung:  docker compose up -d --force-recreate
# Leere Zeilen = Funktion aus. Das Dashboard läuft trotzdem.
# ============================================================

# ---------- PFLICHT ----------
# Passwort für die Anmeldung (lang und zufällig, z. B.: openssl rand -base64 18)
ZENTRALE_PASSWORT=
# Dein Benutzer auf dem Pi (für die SSH-Konsole)
SSH_USER=kerim
# Adresse des Pi im Tailscale-Netz (für Links in den Kacheln)
HOST_NAME=homelabkerim.taila4b96b.ts.net

# ---------- DIENSTE (für Zahlen in den Kacheln) ----------
# Pi-hole: Einstellungen → Web-Oberfläche/API → (Expertenmodus) "App-Passwort konfigurieren"
PIHOLE_PASSWORT=
# Syncthing: Aktionen → Einstellungen → Allgemein → API-Schlüssel
SYNCTHING_API_KEY=
# Jellyfin: Dashboard → API-Schlüssel → +   (auch nötig für Gäste-Konten)
JELLYFIN_API_KEY=
# Nextcloud (optional, Anzahl Dateien): siehe README, Schritt "Nextcloud-Token"
NEXTCLOUD_TOKEN=
# Uptime Kuma (optional): Einstellungen → API-Schlüssel → Hinzufügen
KUMA_API_KEY=

# Links in den Kacheln über Caddy mit HTTPS (https://Host:Port+10000, Vaultwarden auf 443, Zentrale auf 8443)
# HTTPS_LINKS=1

# Ports der Dienste (nur ändern, wenn du sie anders eingerichtet hast)
# NEXTCLOUD_PORT=8080
# JELLYFIN_PORT=8096
# VAULTWARDEN_PORT=8222
# PIHOLE_PORT=8053
# SYNCTHING_PORT=8384
# KUMA_PORT=3001

# Eigene Links für die Kacheln (optional), z. B.:
# NEXTCLOUD_URL=http://homelabkerim.taila4b96b.ts.net:8080/

# Ordner auf dem Pi (für "Wofür der Speicher gebraucht wird")
NEXTCLOUD_DATEN=/mnt/daten/nextcloud
VAULTWARDEN_DATEN=/mnt/daten/vaultwarden
MEDIEN=/mnt/daten/medien
SYNCTHING_DATEN=/mnt/daten/syncthing
JELLYFIN_DATEN=/mnt/daten/jellyfin

# TV-Tab (optional): Jellyfin-Konto, dessen Fortschritt der Fernseher zeigt (Name oder ID; sonst erster Admin)
# JELLYFIN_TV_USER=
# Wetter auf dem TV-Start (Open-Meteo, ohne Schlüssel)
# WETTER_LAT=
# WETTER_LON=

# Namen für Laufwerke nach Einhängepunkt (JSON)
LAUFWERK_NAMEN='{"/":"SD-Karte (System)","/mnt/daten":"System-SSD 128 GB","/mnt/evo":"Samsung 860 EVO","/mnt/backup":"Backup-HDD"}'

# Schönere Gerätenamen (Tailscale-Name → Anzeigename, JSON), z. B.:
# GERAETE_NAMEN='{"desktop-abc123":"Windows-PC","pixel-10-pro":"Pixel 10 Pro","fedora":"Fedora-Laptop"}'

# ---------- MEDIEN (Arr-Stack + Proton VPN) ----------
# qBittorrent-Weboberfläche (läuft über Gluetun, Port 8085): Benutzer + Passwort
QBIT_USER=admin
QBIT_PASSWORT=
# API-Schlüssel jeweils: App öffnen → Settings → General → API Key
SONARR_API_KEY=
RADARR_API_KEY=
LIDARR_API_KEY=
PROWLARR_API_KEY=
# Bazarr: Settings → General → Security → API Key
BAZARR_API_KEY=

# ---------- WINDOWS-PC (Wake-on-LAN) ----------
# MAC-Adresse der LAN-Karte (PowerShell: Get-NetAdapter). PC braucht ein LAN-Kabel.
PC_MAC=
# PC_NAME=Windows-PC
# Name des PCs in Tailscale (für den Online-Status). Leer = das einzige eigene Windows-Gerät.
# PC_TAILSCALE_NAME=
# PC_BROADCAST=255.255.255.255
# Ausschalten per SSH (OpenSSH-Server unter Windows): Windows-Benutzername. Schlüssel zeigt die Zentrale (Übersicht → Windows-PC → «Ausschalten einrichten»).
PC_USER=
# PC_HOST=           (leer = Tailscale-Adresse des PCs)
# PC_SSH_PORT=22

# ---------- FERNSEHER (Philips, JointSpace-API) ----------
# IP-Adresse (TV: Einstellungen → Netzwerk) und WLAN-MAC (Pi: ip neigh show <IP>). Am TV «Mit WLAN einschalten» an.
# What's Up Docker: Token nur mit «Read» (WUD → Profil → Generate Token)
WUD_TOKEN=
# WUD_PORT=3010

# Garmin (garmin-grafana): Passwort = INFLUXDB_PASSWORD aus /mnt/daten/garmin-grafana/.env
GARMIN_INFLUX_PASSWORD=
# GARMIN_SCHRITTE_ZIEL=10000

TV_IP=
TV_MAC=
# TV_NAME=Fernseher
# Seerr: Settings → General → API Key
SEERR_API_KEY=
# Beim Filmabend die Downloads auf die "alternativen Geschwindigkeiten" von qBittorrent drosseln (ja/nein)
FILMABEND_DROSSELN=ja
# Namen/Ports nur ändern, wenn anders eingerichtet:
# VPN_CONTAINER=gluetun
# DOWNLOAD_CONTAINER=qbittorrent
# QBIT_PORT=8085
# SONARR_PORT=8989
# RADARR_PORT=7878
# LIDARR_PORT=8686
# PROWLARR_PORT=9696
# SEERR_PORT=5055

# ---------- GÄSTE ----------
# Tailscale: Admin → Settings → Keys → "Generate access token" (läuft nach max. 90 Tagen ab!)
TS_API_KEY=

# ---------- NTFY-ALARME (eigener Push-Server auf dem Pi) ----------
# Zentrale läuft im Host-Netzwerk → ntfy über localhost. Token: docker exec ntfy ntfy token add <benutzer>
# (Benutzer mit nur Schreibrecht auf das Topic, siehe README)
NTFY_URL=
NTFY_TOKEN=
NTFY_TOPIC=zentrale

# ---------- TELEGRAM-ALARME ----------
# Bot bei @BotFather erstellen (/newbot) → Token. Dem Bot "hallo" schreiben, dann
# https://api.telegram.org/bot<TOKEN>/getUpdates öffnen → "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- ENERGIE ----------
# Shelly-Messstecker (z. B. Shelly Plug S Gen3), leer = Schätzung
SHELLY_URL=
# Strompreis in CHF pro kWh
STROMPREIS=0.30

# ---------- BACKUP (erst wenn die HDD eingehängt ist) ----------
# Einhängepunkt der Backup-HDD, z. B. /mnt/backup
BACKUP_ZIEL=
# Gerät der Backup-HDD für den Schlafmodus, z. B. /dev/disk/by-id/usb-SAMSUNG_HD103UJ_...
BACKUP_DISK=
# Uhrzeit des täglichen Backups
BACKUP_ZEIT=03:00
# Einhängepunkt der HDD für Alarm und automatisches Einhängen (Standard /mnt/backup)
# BACKUP_MOUNT=/mnt/backup
# Was gesichert wird
BACKUP_QUELLE=/mnt/daten
# Ausschliessen (Komma-getrennt, rsync-Muster), z. B. medien/Filme/*
BACKUP_AUSSCHLIESSEN=

# ---------- LÜFTER (erst nach Einbau, siehe README) ----------
# leer = aus, "auto" = Hardware-PWM auf GPIO 18 nach dtoverlay=pwm
LUEFTER_PWM=

# ---------- GOOGLE (Tab «Heute»: Mail aufräumen, Kalender, Aufgaben) ----------
# Google Cloud → Projekt → APIs aktivieren (Gmail, Calendar, Tasks) → OAuth-Client «Webanwendung»
# Weiterleitungs-URI: https://homelabkerim.taila4b96b.ts.net:8443/api/google/zurueck
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
