#!/bin/bash
# Installiert ZentraleOS aus dem Live-System fest auf eine Platte (UEFI, GPT).
# Läuft als Root über den Helfer. Eingabe (Standardeingabe), je eine Zeile:
#   Gerät (z. B. /dev/sda) · Benutzername · Passwort · Verschlüsselungs-Passwort (leer = keine)
# DIE GEWÄHLTE PLATTE WIRD VOLLSTÄNDIG GELÖSCHT.
set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin
PROT=/run/zos-installation.log; : > "$PROT"; chmod 644 "$PROT"
sag() { echo "$*" | tee -a "$PROT"; }
ende() { sag "FEHLER: $*"; exit 1; }
IFS= read -r GERAET; IFS= read -r NAME; IFS= read -r PW; IFS= read -r LUKS || LUKS=""
exec 2>>"$PROT"

grep -qw boot=live /proc/cmdline || ende "Die Installation geht nur aus dem Live-System (vom Stick gestartet)."
[ -d /sys/firmware/efi ] || ende "Dieser Rechner wurde nicht im UEFI-Modus gestartet."
case "$GERAET" in /dev/sd[a-z]|/dev/vd[a-z]|/dev/nvme[0-9]n[0-9]|/dev/mmcblk[0-9]) ;; *) ende "Ungültiges Gerät: $GERAET";; esac
[ -b "$GERAET" ] || ende "Gerät nicht gefunden: $GERAET"
echo "$NAME" | grep -Eq '^[a-z][a-z0-9-]{0,30}$' || ende "Benutzername: nur Kleinbuchstaben, Ziffern und Bindestrich."
[ "${#PW}" -ge 4 ] || ende "Das Passwort braucht mindestens 4 Zeichen."
MEDIUM="$(findmnt -no SOURCE /run/live/medium 2>/dev/null || true)"
if [ -n "$MEDIUM" ]; then
  ELTERN="$(lsblk -no PKNAME "$MEDIUM" 2>/dev/null | head -1)"
  [ "/dev/$ELTERN" = "$GERAET" ] || [ "$MEDIUM" = "$GERAET" ] && ende "Das ist der Stick, von dem das System gerade läuft."
fi
[ "$(blockdev --getsize64 "$GERAET")" -ge 15000000000 ] || ende "Die Platte ist kleiner als 15 GB."
QUELLE=/run/live/rootfs/filesystem.squashfs; [ -d "$QUELLE/usr" ] || ende "Live-Dateisystem nicht gefunden."
case "$GERAET" in *nvme*|*mmcblk*) P="${GERAET}p";; *) P="$GERAET";; esac
ZIEL=/mnt/zos-ziel

aufraeumen() { umount -R "$ZIEL" 2>/dev/null || true; cryptsetup close zos-root 2>/dev/null || true; }
trap aufraeumen EXIT

sag "1/7 Platte vorbereiten ($GERAET)"
swapoff -a 2>/dev/null || true
for t in $(lsblk -lno NAME "$GERAET" | tail -n +2); do umount -f "/dev/$t" 2>/dev/null || true; done
wipefs -af "$GERAET" >/dev/null
sgdisk --zap-all "$GERAET" >/dev/null
if [ -n "$LUKS" ]; then
  sgdisk -n1:0:+512M -t1:ef00 -c1:EFI -n2:0:+1G -t2:8300 -c2:zos-boot -n3:0:0 -t3:8309 -c3:ZentraleOS "$GERAET" >/dev/null
else
  sgdisk -n1:0:+512M -t1:ef00 -c1:EFI -n2:0:0 -t2:8300 -c2:ZentraleOS "$GERAET" >/dev/null
fi
partprobe "$GERAET"; udevadm settle; sleep 1
mkfs.vfat -F32 -n EFI "${P}1" >/dev/null
if [ -n "$LUKS" ]; then
  sag "2/7 Verschlüsselung einrichten"
  mkfs.ext4 -qF -L zos-boot "${P}2"
  printf '%s' "$LUKS" | cryptsetup luksFormat --batch-mode --key-file - "${P}3"
  printf '%s' "$LUKS" | cryptsetup open --key-file - "${P}3" zos-root
  WURZEL=/dev/mapper/zos-root
else
  sag "2/7 Ohne Verschlüsselung"
  WURZEL="${P}2"
fi
mkfs.ext4 -qF -L ZentraleOS "$WURZEL"
mkdir -p "$ZIEL"; mount "$WURZEL" "$ZIEL"
if [ -n "$LUKS" ]; then mkdir -p "$ZIEL/boot"; mount "${P}2" "$ZIEL/boot"; fi
mkdir -p "$ZIEL/boot/efi"; mount "${P}1" "$ZIEL/boot/efi"

sag "3/7 System kopieren (dauert einige Minuten)"
rsync -aHAX "$QUELLE/" "$ZIEL/"

sag "4/7 Einrichten"
{
  echo "UUID=$(blkid -s UUID -o value "$WURZEL") / ext4 errors=remount-ro,noatime 0 1"
  [ -n "$LUKS" ] && echo "UUID=$(blkid -s UUID -o value "${P}2") /boot ext4 defaults,noatime 0 2"
  echo "UUID=$(blkid -s UUID -o value "${P}1") /boot/efi vfat umask=0077 0 2"
} > "$ZIEL/etc/fstab"
[ -n "$LUKS" ] && echo "zos-root UUID=$(blkid -s UUID -o value "${P}3") none luks,discard" > "$ZIEL/etc/crypttab"
: > "$ZIEL/etc/machine-id"; rm -f "$ZIEL/var/lib/dbus/machine-id"
printf 'XKBMODEL="pc105"\nXKBLAYOUT="ch"\nXKBVARIANT=""\nXKBOPTIONS=""\nBACKSPACE="guess"\n' > "$ZIEL/etc/default/keyboard"
cat > "$ZIEL/etc/default/grub" <<'GRUB'
GRUB_DEFAULT=0
GRUB_TIMEOUT=2
GRUB_DISTRIBUTOR="ZentraleOS"
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"
GRUB_CMDLINE_LINUX=""
GRUB_DISABLE_OS_PROBER=true
GRUB
for d in dev dev/pts proc sys run; do mount --bind "/$d" "$ZIEL/$d"; done
mount -t efivarfs efivarfs "$ZIEL/sys/firmware/efi/efivars" 2>/dev/null || true
im() { chroot "$ZIEL" /usr/bin/env PATH=/usr/sbin:/usr/bin:/sbin:/bin DEBIAN_FRONTEND=noninteractive "$@"; }

sag "5/7 Benutzer «$NAME»"
if [ "$NAME" != zentrale ]; then
  im usermod -l "$NAME" -d "/home/$NAME" -m zentrale
  im groupmod -n "$NAME" zentrale
fi
printf '%s:%s\n' "$NAME" "$PW" | im chpasswd

sag "6/7 Live-Teile entfernen, Startabbild bauen"
im apt-get -y -q purge live-boot live-boot-initramfs-tools live-config live-config-systemd live-tools >>"$PROT" 2>&1 || sag "Hinweis: Live-Pakete liessen sich nicht alle entfernen."
im update-initramfs -u -k all >>"$PROT" 2>&1

sag "7/7 Startprogramm (GRUB)"
im grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=ZentraleOS --recheck >>"$PROT" 2>&1 || sag "Hinweis: Eintrag in der Firmware nicht möglich, nutze den Standardpfad."
im grub-install --target=x86_64-efi --efi-directory=/boot/efi --removable --no-nvram >>"$PROT" 2>&1
im update-grub >>"$PROT" 2>&1
sync
umount -R "$ZIEL"; trap - EXIT; cryptsetup close zos-root 2>/dev/null || true
sag "FERTIG. Stick abziehen und neu starten."
