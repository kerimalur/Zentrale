#!/bin/bash
# Root-Helfer von ZentraleOS. Wird nur über sudo (mit Administrator-Passwort) aufgerufen.
# Jede Aktion ist eine feste Unterfunktion – es wird nie beliebiger Text ausgeführt.
set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin
NFT=/etc/nftables.conf
case "${1:-}" in
  pruefen) echo ok ;;
  firewall-anwenden)
    # Neue Regeln kommen über die Standardeingabe. Erst prüfen, dann anwenden,
    # dann 60 Sekunden auf Bestätigung warten – sonst zurück zum alten Stand.
    neu="$(mktemp)"; cat > "$neu"
    nft -c -f "$neu" || { rm -f "$neu"; echo "Regeln fehlerhaft" >&2; exit 2; }
    [ -f "$NFT.vorher" ] || cp -a "$NFT" "$NFT.vorher"
    install -m 0644 "$neu" "$NFT"; rm -f "$neu"
    nft -f "$NFT" || { cp -a "$NFT.vorher" "$NFT"; nft -f "$NFT"; exit 3; }
    systemctl stop zos-fw-ruecknahme.timer zos-fw-ruecknahme.service 2>/dev/null
    systemctl reset-failed zos-fw-ruecknahme.service 2>/dev/null
    # AccuracySec=1s: sonst darf systemd den Zeitpunkt um bis zu eine Minute verschieben
    systemd-run --quiet --unit=zos-fw-ruecknahme --timer-property=AccuracySec=1s --on-active="${2:-60}" /usr/libexec/zentraleos/helfer firewall-zuruecknehmen
    echo angewendet ;;
  firewall-bestaetigen)
    systemctl stop zos-fw-ruecknahme.timer 2>/dev/null; rm -f "$NFT.vorher"; echo bestaetigt ;;
  firewall-zuruecknehmen)
    [ -f "$NFT.vorher" ] || exit 0
    mv -f "$NFT.vorher" "$NFT"; nft -f "$NFT"; logger -t zentraleos "Firewall-Änderung zurückgenommen"; echo zurueckgenommen ;;
  firewall-zustand) nft list ruleset ;;
  firewall-protokoll) journalctl -k -g ZOS-VERWORFEN -n "${2:-60}" --no-pager -o short-iso 2>/dev/null ;;
  ports) ss -tulnpH ;;
  ssh)
    if [ "${2:-}" = an ]; then systemctl enable --now ssh; else systemctl disable --now ssh; fi ;;
  zeitzone) timedatectl set-timezone "$2" ;;
  ntp) timedatectl set-ntp "$2" ;;
  hostname) hostnamectl set-hostname "$2" ;;
  tastatur)
    case "$2" in *[!a-z]*) exit 2;; esac
    sed -i "s/^XKBLAYOUT=.*/XKBLAYOUT=\"$2\"/" /etc/default/keyboard ;;
  updates-suchen) apt-get update -q 2>&1 | tail -3; apt list --upgradable 2>/dev/null | tail -n +2 ;;
  updates-einspielen) DEBIAN_FRONTEND=noninteractive apt-get -y -q dist-upgrade 2>&1 | tail -15 ;;
  auto-updates)
    printf 'APT::Periodic::Update-Package-Lists "%s";\nAPT::Periodic::Unattended-Upgrade "%s";\n' "$2" "$2" > /etc/apt/apt.conf.d/20auto-upgrades ;;
  paket-installieren)
    case "$2" in *[!a-z0-9.+-]*) exit 2;; esac
    DEBIAN_FRONTEND=noninteractive apt-get -y -q install "$2" 2>&1 | tail -8 ;;
  passwort)
    # "benutzer:passwort" kommt über die Standardeingabe
    chpasswd ;;
  tailscale-anmelden)
    # Erlaubt dem Benutzer danach, Tailscale selbst zu bedienen (Exit-Node usw.), und gibt den Anmelde-Link aus.
    tailscale set --operator="${SUDO_USER:-zentrale}" 2>/dev/null
    timeout 8 tailscale up --operator="${SUDO_USER:-zentrale}" 2>&1 | grep -o 'https://login.tailscale.com[^ ]*' | head -1; true ;;
  protokoll) journalctl -b -n "${2:-200}" --no-pager -o short-iso ;;
  energie) case "$2" in neustart) systemctl reboot;; aus) systemctl poweroff;; firmware) systemctl reboot --firmware-setup;; esac ;;
  installieren) exec /usr/libexec/zentraleos/installieren ;;
  usb-erlauben|usb-sperren)
    case "${2:-}" in ''|*[!0-9]*) exit 2;; esac
    if [ "$1" = usb-erlauben ]; then usbguard allow-device -p "$2"; else usbguard block-device -p "$2"; fi ;;
  schnappschuss-liste) timeshift --list --scripted 2>&1 | tail -n +1 ;;
  schnappschuss-erstellen)
    k="$(printf '%s' "${2:-von Hand}" | tr -cd 'A-Za-z0-9 äöüÄÖÜ._-' | cut -c1-60)"
    timeshift --create --comments "$k" --tags O --scripted 2>&1 | tail -5 ;;
  schnappschuss-loeschen|schnappschuss-zurueck)
    echo "${2:-}" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}-[0-9]{2}$' || exit 2
    if [ "$1" = schnappschuss-loeschen ]; then timeshift --delete --snapshot "$2" --scripted 2>&1 | tail -3
    else timeshift --restore --snapshot "$2" --scripted --yes --skip-grub 2>&1 | tail -8; fi ;;
  firmware-suchen) fwupdmgr refresh --force >/dev/null 2>&1; fwupdmgr get-updates --no-unreported-check 2>&1 | tail -40 ;;
  firmware-einspielen) fwupdmgr update -y --no-reboot-check 2>&1 | tail -15 ;;
  aufraeumen)
    vorher=$(df --output=avail -B1 / | tail -1)
    apt-get clean; journalctl --vacuum-size=200M >/dev/null 2>&1; flatpak uninstall --unused -y >/dev/null 2>&1
    rm -rf /var/tmp/*.tmp 2>/dev/null; nachher=$(df --output=avail -B1 / | tail -1)
    echo $(( (nachher - vorher) / 1048576 )) ;;
  tpm-binden)
    # Verschlüsselte Systemplatte an den TPM-Chip binden (Wiederherstellungs-Passwort kommt über die Standardeingabe).
    dev="$(awk '!/^#/ && NF {print $2; exit}' /etc/crypttab)"; dev="${dev#UUID=}"; [ -n "$dev" ] || { echo "Keine verschlüsselte Platte" >&2; exit 3; }
    pw="$(cat)"; for s in $(clevis luks list -d "/dev/disk/by-uuid/$dev" 2>/dev/null | cut -d: -f1); do clevis luks unbind -d "/dev/disk/by-uuid/$dev" -s "$s" -f; done
    printf '%s' "$pw" | clevis luks bind -y -k - -d "/dev/disk/by-uuid/$dev" tpm2 '{"pcr_bank":"sha256","pcr_ids":"7"}' && update-initramfs -u >/dev/null 2>&1 && echo gebunden ;;
  pruefung-jetzt) systemctl start --no-block zentraleos-pruefung.service; echo gestartet ;;
  ip-entsperren)
    echo "${2:-}" | grep -Eq '^[0-9a-fA-F:.]{3,45}$' || exit 2
    case "$2" in *:*) nft delete element inet zentraleos gesperrt6 "{ $2 }";; *) nft delete element inet zentraleos gesperrt4 "{ $2 }";; esac ;;
  smart)
    case "$2" in /dev/sd[a-z]|/dev/nvme[0-9]n[0-9]|/dev/vd[a-z]|/dev/mmcblk[0-9]) smartctl -H -A -i "$2" 2>&1 | head -80 ;; *) exit 2;; esac ;;
  fokus-sperre)
    # Sperrt Internetseiten über /etc/hosts. Die Liste (ein Name pro Zeile) kommt über die Standardeingabe; leer = aufheben.
    sed -i '/# ZOS-FOKUS$/d' /etc/hosts
    while IFS= read -r n; do
      case "$n" in ''|*[!a-z0-9.-]*) continue;; esac
      printf '0.0.0.0 %s # ZOS-FOKUS\n0.0.0.0 www.%s # ZOS-FOKUS\n' "$n" "$n" >> /etc/hosts
    done
    systemctl stop zos-fokus-ende.timer 2>/dev/null; systemctl reset-failed zos-fokus-ende.service 2>/dev/null
    # Mit Sekundenangabe: die Sperre hebt sich danach von selbst auf, auch wenn die Oberfläche nicht läuft.
    case "${2:-}" in ''|*[!0-9]*) ;; *) systemd-run --quiet --unit=zos-fokus-ende --timer-property=AccuracySec=1s --on-active="$2" /usr/libexec/zentraleos/helfer fokus-sperre ;; esac
    echo ok ;;
  ssh-fern)
    # SSH nur über Tailscale: Dienst an, aber er hört nur auf der Tailscale-Adresse.
    if [ "${2:-}" = an ]; then
      ip="$(tailscale ip -4 2>/dev/null | head -1)"; [ -n "$ip" ] || { echo "Tailscale ist nicht verbunden" >&2; exit 3; }
      mkdir -p /etc/ssh/sshd_config.d; printf 'ListenAddress %s\nPasswordAuthentication yes\nPermitRootLogin no\n' "$ip" > /etc/ssh/sshd_config.d/zentraleos.conf
      mkdir -p /etc/systemd/system/ssh.service.d; printf '[Unit]\nAfter=tailscaled.service\nWants=tailscaled.service\n[Service]\nRestart=on-failure\nRestartSec=10\n' > /etc/systemd/system/ssh.service.d/zentraleos.conf
      systemctl daemon-reload; systemctl enable ssh >/dev/null 2>&1; systemctl restart ssh; echo "an $ip"
    else systemctl disable --now ssh >/dev/null 2>&1; rm -f /etc/ssh/sshd_config.d/zentraleos.conf; echo aus; fi ;;
  update-fenster)
    # Automatische Updates nur im Wartungsfenster: $2 = aus | Wochentag (Mon..Sun), $3 = Stunde
    mkdir -p /etc/systemd/system/apt-daily-upgrade.timer.d /etc/systemd/system/apt-daily-upgrade.service.d
    if [ "$2" = aus ]; then
      rm -f /etc/systemd/system/apt-daily-upgrade.timer.d/zentraleos.conf
    else
      case "$2" in Mon|Tue|Wed|Thu|Fri|Sat|Sun) ;; *) exit 2;; esac; case "$3" in ''|*[!0-9]*) exit 2;; esac
      printf '[Timer]\nOnCalendar=\nOnCalendar=%s *-*-* %02d:00\nRandomizedDelaySec=0\n' "$2" "$3" > /etc/systemd/system/apt-daily-upgrade.timer.d/zentraleos.conf
    fi
    printf '[Service]\nExecCondition=/usr/libexec/zentraleos/update-erlaubt\n' > /etc/systemd/system/apt-daily-upgrade.service.d/zentraleos.conf
    systemctl daemon-reload; systemctl restart apt-daily-upgrade.timer; echo ok ;;
  *) echo "Unbekannte Aktion" >&2; exit 64 ;;
esac
