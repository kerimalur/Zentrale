#!/bin/sh
# Hält die Shell am Leben: stürzt sie ab, startet sie neu. Stürzt sie immer wieder ab,
# kommt die Notfall-Sitzung (Passwort nötig), danach beginnt es von vorn.
E=/opt/zentraleos/shell/node_modules/electron/dist/electron
ARGS="--ozone-platform=wayland --enable-wayland-ime --class=zentraleos-shell --password-store=basic"
grep -qw zos.demo /proc/cmdline && ARGS="$ARGS --demo"
# Nur für automatische Tests in einer VM (siehe /usr/libexec/zentraleos/testmodus)
grep -qw zos.test /proc/cmdline && systemd-detect-virt -q --vm && ARGS="$ARGS --remote-debugging-port=9222"
while true; do
  n=0; anfang=$(date +%s)
  while [ $n -lt 6 ]; do
    ZOS_SHELL_SKRIPT=1 "$E" /opt/zentraleos/shell $ARGS >>"${XDG_RUNTIME_DIR:-/tmp}/shell.log" 2>&1
    rc=$?
    [ $rc -eq 0 ] && exit 0
    # 75 = gewollter Neustart (z. B. nach einem Update der Oberfläche): sofort wieder starten, zählt nicht als Absturz
    [ $rc -eq 75 ] && { anfang=$(date +%s); continue; }
    # Lief sie länger als zwei Minuten, zählt der Absturz neu.
    jetzt=$(date +%s); [ $((jetzt - anfang)) -gt 120 ] && n=0; anfang=$jetzt
    n=$((n+1))
    # Abgestürzt: sofort eine echte Sperre (ext-session-lock) über alles legen, bevor die Oberfläche neu startet –
    # sonst lägen fremde Fenster für einen Moment offen. Entsperren mit dem Code der Oberfläche oder dem Passwort.
    command -v swaylock >/dev/null && swaylock -e -F -c 08130e --indicator-radius 80 2>/dev/null || sleep 1
  done
  foot --fullscreen -e /usr/libexec/zentraleos/notfall || sleep 5
done
