#!/bin/sh
# Startet die grafische Sitzung von ZentraleOS (labwc + Shell).
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=ZentraleOS
export XKB_DEFAULT_LAYOUT="$(. /etc/default/keyboard 2>/dev/null; echo "${XKBLAYOUT:-ch}")"
export MOZ_ENABLE_WAYLAND=1
[ -f /etc/zentraleos/sitzung.env ] && . /etc/zentraleos/sitzung.env
PROTOKOLL="${XDG_RUNTIME_DIR:-/tmp}/labwc.log"
# Ohne echte Grafikkarte (virtuelle Maschine, «sicherer Grafikmodus») rechnet der Compositor
# selbst (pixman). Mit Software-OpenGL stürzte labwc in der Test-VM ab.
if grep -qw zos.pixman /proc/cmdline || systemd-detect-virt -q --vm; then export WLR_RENDERER=pixman; fi
labwc >"$PROTOKOLL" 2>&1
code=$?
# Stürzt der Compositor mit Grafikbeschleunigung ab, einmal ohne neu starten statt am Textbildschirm zu landen.
if [ $code -ne 0 ] && [ -z "${WLR_RENDERER:-}" ]; then
  cp "$PROTOKOLL" "$PROTOKOLL.1" 2>/dev/null
  export WLR_RENDERER=pixman
  exec labwc >"$PROTOKOLL" 2>&1
fi
exit $code
