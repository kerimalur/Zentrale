# Verlauf, Logo in der Mitte, drei pulsierende Punkte darunter.
Window.SetBackgroundTopColor(0.04, 0.07, 0.16);
Window.SetBackgroundBottomColor(0.09, 0.17, 0.42);
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 30);
punkt.image = Image("punkt.png");
for (i = 0; i < 3; i++) {
  punkte[i] = Sprite(punkt.image);
  punkte[i].SetX(Window.GetWidth() / 2 - 30 + i * 24);
  punkte[i].SetY(Window.GetHeight() / 2 + logo.image.GetHeight() / 2 + 10);
}
zeit = 0;
fun auffrischen() {
  zeit++;
  for (i = 0; i < 3; i++) {
    punkte[i].SetOpacity(0.25 + 0.75 * Math.Abs(Math.Sin(zeit / 14 - i * 0.7)));
  }
  logo.sprite.SetOpacity(Math.Min(1, zeit / 30));
}
Plymouth.SetRefreshFunction(auffrischen);
fun passwort(aufforderung, punkteZahl) {
  text.image = Image.Text(aufforderung + " " + "●" * 0, 1, 1, 1);
  text.sprite = Sprite(text.image);
  text.sprite.SetX(Window.GetWidth() / 2 - text.image.GetWidth() / 2);
  text.sprite.SetY(Window.GetHeight() * 0.75);
}
Plymouth.SetDisplayPasswordFunction(passwort);
