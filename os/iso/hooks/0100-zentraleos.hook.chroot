#!/bin/sh
set -e
# Sprache: Deutsch (Schweiz)
sed -i 's/^# *\(de_CH.UTF-8\)/\1/; s/^# *\(en_US.UTF-8\)/\1/' /etc/locale.gen
locale-gen
update-locale LANG=de_CH.UTF-8
ln -sf /usr/share/zoneinfo/Europe/Zurich /etc/localtime
echo Europe/Zurich > /etc/timezone
echo zentraleos > /etc/hostname

# Benutzer der Live-Sitzung. Kein Root ohne Passwort: sudo fragt immer nach.
if ! id zentrale >/dev/null 2>&1; then
  useradd -m -s /bin/bash -c "ZentraleOS" -G sudo,audio,video,netdev,plugdev,bluetooth,input,adm,systemd-journal zentrale
  # Live-System: Administrator-Passwort 1234 (gleich wie der Demo-Code). Bei der Installation legst du ein eigenes fest.
  echo 'zentrale:1234' | chpasswd
fi
passwd -l root

# Dienste
systemctl enable zentraleos-testmodus.service zentraleos-diagnose.timer greetd.service zentraleos-greetd-einrichten.service nftables.service NetworkManager.service bluetooth.service apparmor.service
# Sicherheit und Dauerbetrieb
systemctl enable zentraleos-waechter.service zentraleos-usb-regeln.service usbguard.service earlyoom.service zentraleos-pruefung.timer zentraleos-schnappschuss.timer fstrim.timer
# Timeshift soll nicht selbst per cron planen (das macht zentraleos-schnappschuss.timer)
# Mitgelieferte Zeitpläne, die ohne Vorbereitung fehlschlagen würden: macht die Wochenprüfung bzw. der Knopf in den Einstellungen
systemctl disable dailyaidecheck.timer fwupd-refresh.timer 2>/dev/null || true
rm -f /etc/cron.d/timeshift-hourly /etc/cron.d/timeshift-boot 2>/dev/null || true
# AppArmor: mitgelieferte Profile scharf schalten, soweit sie nicht stören
for pr in /etc/apparmor.d/usr.bin.man /etc/apparmor.d/usr.sbin.tcpdump; do [ -f "$pr" ] && aa-enforce "$pr" >/dev/null 2>&1 || true; done
systemctl disable ssh.service 2>/dev/null || true
# smartd nur auf Abruf (in VMs findet er keine Platte und gilt dann als fehlgeschlagen)
systemctl disable smartmontools.service smartd.service 2>/dev/null || true
systemctl mask smartmontools.service 2>/dev/null || true
systemctl set-default graphical.target

# Startanimation
plymouth-set-default-theme zentraleos

# Electron-Sandbox braucht setuid
if [ -f /opt/zentraleos/shell/node_modules/electron/dist/chrome-sandbox ]; then
  chown root:root /opt/zentraleos/shell/node_modules/electron/dist/chrome-sandbox
  chmod 4755 /opt/zentraleos/shell/node_modules/electron/dist/chrome-sandbox
fi
chmod -R a+rX /opt/zentraleos

# Flathub (systemweit bekannt machen; installiert wird pro Benutzer)
flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || true

# Tailscale aus dem offiziellen Paketarchiv
if curl -fsSL https://pkgs.tailscale.com/stable/debian/trixie.noarmor.gpg -o /usr/share/keyrings/tailscale-archive-keyring.gpg; then
  echo "deb [signed-by=/usr/share/keyrings/tailscale-archive-keyring.gpg] https://pkgs.tailscale.com/stable/debian trixie main" > /etc/apt/sources.list.d/tailscale.list
  apt-get update -q && apt-get install -y -q tailscale && systemctl enable tailscaled.service || echo "WARNUNG: Tailscale nicht installiert"
else
  echo "WARNUNG: Tailscale-Paketquelle nicht erreichbar – Tailscale fehlt in diesem Abbild"
fi

# Brave aus dem offiziellen Paketarchiv (Standard-Browser; fehlt er, bleibt Chromium)
if curl -fsSL https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg -o /usr/share/keyrings/brave-browser-archive-keyring.gpg; then
  echo "deb [signed-by=/usr/share/keyrings/brave-browser-archive-keyring.gpg arch=amd64] https://brave-browser-apt-release.s3.brave.com/ stable main" > /etc/apt/sources.list.d/brave-browser-release.list
  apt-get update -q && apt-get install -y -q brave-browser || echo "WARNUNG: Brave nicht installiert"
  # Kein Schlüsselbund-Fenster
  [ -f /usr/share/applications/brave-browser.desktop ] && sed -i 's|^Exec=/usr/bin/brave-browser-stable|Exec=/usr/bin/brave-browser-stable --password-store=basic|' /usr/share/applications/brave-browser.desktop
else
  echo "WARNUNG: Brave-Paketquelle nicht erreichbar – Brave fehlt in diesem Abbild"
fi

# Automatische Updates: nur im Wartungsfenster (Samstag 10 Uhr) und nie bei offenen Positionen
mkdir -p /etc/systemd/system/apt-daily-upgrade.timer.d /etc/systemd/system/apt-daily-upgrade.service.d
printf '[Timer]\nOnCalendar=\nOnCalendar=Sat *-*-* 10:00\nRandomizedDelaySec=0\n' > /etc/systemd/system/apt-daily-upgrade.timer.d/zentraleos.conf
printf '[Service]\nExecCondition=/usr/libexec/zentraleos/update-erlaubt\n' > /etc/systemd/system/apt-daily-upgrade.service.d/zentraleos.conf

# Automatische Sicherheitsupdates an (abschaltbar in den Einstellungen)
printf 'APT::Periodic::Update-Package-Lists "1";\nAPT::Periodic::Unattended-Upgrade "1";\n' > /etc/apt/apt.conf.d/20auto-upgrades
apt-get clean
